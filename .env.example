# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_channel
USER_ID=123456789

# --- Anthropic (рерайт/адаптация контента) ---
ANTHROPIC_API_KEY=

# --- Источники контента ---
NEWS_API_KEY=

# --- Генерация иллюстраций (опционально) ---
REPLICATE_API_KEY=

# --- Telethon: парсинг Telegram-каналов (опционально, по умолчанию выключено) ---
# Требует api_id/api_hash с my.telegram.org и одноразового интерактивного
# логина локально для создания data/telethon.session — см. README.
TELETHON_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_CHANNELS=
TELETHON_LOOKBACK_HOURS=24

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_channel
USER_ID=123456789

# --- Anthropic (рерайт/адаптация контента) ---
ANTHROPIC_API_KEY=

# --- Источники контента ---
NEWS_API_KEY=

# --- Генерация иллюстраций (опционально) ---
REPLICATE_API_KEY=

# --- Telethon: парсинг Telegram-каналов (опционально, по умолчанию выключено) ---
# Требует api_id/api_hash с my.telegram.org и одноразового интерактивного
# логина локально для создания data/telethon.session — см. README.
TELETHON_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_CHANNELS=
TELETHON_LOOKBACK_HOURS=24

# --- LinkedIn (Фаза 3, в подготовке) ---
# Client ID/Secret — с вкладки Auth вашего приложения в LinkedIn Developer Portal.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Токены получаются локально через scripts/linkedin_auth.py — см. README.
LINKEDIN_PERSONAL_ACCESS_TOKEN=
LINKEDIN_PERSONAL_REFRESH_TOKEN=
LINKEDIN_COMPANY_ACCESS_TOKEN=
LINKEDIN_COMPANY_REFRESH_TOKEN=
# urn:li:organization:XXXXXXX — id страницы aiu, см. README
LINKEDIN_ORGANIZATION_URN=
